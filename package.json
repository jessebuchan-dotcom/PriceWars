{
  "name":"price-wars-business-simulation",
  "version":"1.0.0",
  "private":true,
  "type":"module",
  "scripts":{
    "dev":"concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build":"tsc -p tsconfig.server.json && vite build",
    "start":"node dist-server/server/index.js",
    "test":"tsx --test tests/*.test.ts",
    "check":"tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies":{
    "dotenv":"^16.5.0",
    "express":"^4.21.2",
    "firebase-admin":"^13.4.0",
    "lucide-react":"^0.468.0",
    "qrcode.react":"^4.2.0",
    "react":"^19.0.0",
    "react-dom":"^19.0.0",
    "recharts":"^2.15.3",
    "socket.io":"^4.8.1",
    "socket.io-client":"^4.8.1"
  },
  "devDependencies":{
    "@types/express":"^4.17.21",
    "@types/node":"^22.13.10",
    "@types/react":"^19.0.12",
    "@types/react-dom":"^19.0.4",
    "@vitejs/plugin-react":"^4.3.4",
    "concurrently":"^9.1.2",
    "tsx":"^4.19.3",
    "typescript":"^5.8.2",
    "vite":"^6.2.2"
  }
}
